# PostgreSQL
POSTGRES_DB=cinebook
POSTGRES_USER=cinebook_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=reservation_confirmed

# Email (Mailhog for dev)
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=noreply@cinebook.local

# App
JWT_SECRET_KEY=change_this_to_a_long_random_string_min_50_chars
# Comma-separated URLs are supported.
# In Docker Compose use: http://reservation-service:8001
# If web_app runs directly on host, add localhost fallback:
# RESERVATION_SERVICE_URL=http://reservation-service:8001,http://localhost:8001
RESERVATION_SERVICE_URL=http://reservation-service:8001
# Needed only if using underscore hostnames (e.g. reservation_service) to avoid Django DisallowedHost.
RESERVATION_SERVICE_HOST_HEADER=localhost
TICKETS_DIR=/tickets
DEBUG=False
